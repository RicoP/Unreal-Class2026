(asset "/Game/Extern_Assets/UAL2_Standard/SkeletalMeshes/UAL2_StandardMelee_Hook"
  (class "AnimSequence")
  (revision working-copy)
  (properties
    (set "BoneCompressionSettings" "/Script/Engine.AnimBoneCompressionSettings'/ACLPlugin/ACLAnimBoneCompressionSettings.ACLAnimBoneCompressionSettings'" (display "Bone Compression Settings"))
    (set "CurveCompressionSettings" "/Script/Engine.AnimCurveCompressionSettings'/ACLPlugin/ACLAnimCurveCompressionSettings.ACLAnimCurveCompressionSettings'" (display "Curve Compression Settings"))
    (set "VariableFrameStrippingSettings" "/Script/Engine.VariableFrameStrippingSettings'/Engine/Animation/DefaultVariableFrameStrippingSettings.DefaultVariableFrameStrippingSettings'" (display "Variable Frame Stripping Settings"))
    (set "NumberOfSampledKeys" "15" (display "Number Of Sampled Keys"))
    (set "NumberOfSampledFrames" "14" (display "Number Of Sampled Frames"))
    (set "DataModelInterface" "AnimationSequencerDataModel'/Game/Extern_Assets/UAL2_Standard/SkeletalMeshes/UAL2_StandardMelee_Hook.UAL2_StandardMelee_Hook:AnimationSequencerDataModel'" (display "Data Model Interface"))
    (set "Controller" "AnimSequencerController'/Engine/Transient.AnimSequencerController_84'" (display "Controller"))
    (set "Skeleton" "/Script/Engine.Skeleton'/Game/Extern_Assets/UAL2_Standard/SkeletalMeshes/UAL2_Standard_Skeleton.UAL2_Standard_Skeleton'" (display "Skeleton"))
    (set "AssetUserData" "(\"/Script/AnimationModifiers.AnimationModifiersAssetUserData'/Game/Extern_Assets/UAL2_Standard/SkeletalMeshes/UAL2_StandardMelee_Hook.UAL2_StandardMelee_Hook:AnimationModifiersAssetUserData_0'\")" (display "Asset User Data"))))
