    (set "DataModelInterface" "AnimationSequencerDataModel'/Game/Extern_Assets/UAL1_Standard/SkeletalMeshes/UAL1_StandardRoll_RETARGET.UAL1_StandardRoll_RETARGET:AnimationSequencerDataModel'" (display "Data Model Interface"))
