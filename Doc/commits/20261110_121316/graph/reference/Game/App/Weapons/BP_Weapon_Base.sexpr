(blueprint "/Game/App/Weapons/BP_Weapon_Base"
  (revision working-copy)
  (parent "/Script/Engine.Actor")
  (variables)
  (components
    (component "Pivot" (class "SceneComponent") (kind added)
      (properties))
    (component "Sphere" (class "SphereComponent") (kind added) (attach-to "Weapon")
      (properties
        (set "BodyInstance ObjectType" "ECC_WorldStatic")
        (set "BodyInstance CollisionEnabled" "NoCollision")
        (set "BodyInstance bNotifyRigidBodyCollision" "True")
        (set "BodyInstance CollisionProfileName" "Custom")
        (set "BodyInstance CollisionResponses" "(ResponseArray=((Channel=\"Visibility\",Response=ECR_Ignore),(Channel=\"Camera\",Response=ECR_Ignore),(Channel=\"WorldStatic\",Response=ECR_Ignore),(Channel=\"WorldDynamic\",Response=ECR_Ignore),(Channel=\"Pawn\",Response=ECR_Overlap),(Channel=\"PhysicsBody\",Response=ECR_Ignore),(Channel=\"Vehicle\",Response=ECR_Ignore),(Channel=\"Destructible\",Response=ECR_Ignore)))")
        (set "BodyInstance bEnableGravity" "False")
        (set "RelativeLocation" "(X=0.000000,Y=0.000000,Z=38.685858)")
        (set "RelativeScale3D" "(X=2.000000,Y=2.000000,Z=2.000000)")))
    (component "Weapon" (class "StaticMeshComponent") (kind added) (attach-to "Pivot")
      (properties
        (set "StaticMesh" "/Script/Engine.StaticMesh'/Game/itch-assets/StaticMeshes/dagger_A.dagger_A'")
        (set "BodyInstance CollisionEnabled" "QueryOnly")
        (set "BodyInstance CollisionProfileName" "Custom")
        (set "BodyInstance CollisionResponses" "(ResponseArray=((Channel=\"Visibility\",Response=ECR_Ignore),(Channel=\"Camera\",Response=ECR_Ignore),(Channel=\"WorldStatic\",Response=ECR_Ignore),(Channel=\"WorldDynamic\",Response=ECR_Ignore),(Channel=\"Pawn\",Response=ECR_Ignore),(Channel=\"PhysicsBody\",Response=ECR_Ignore),(Channel=\"Vehicle\",Response=ECR_Ignore),(Channel=\"Destructible\",Response=ECR_Ignore)))")
        (set "RelativeLocation" "(X=0.000000,Y=0.000000,Z=-8.630399)")
        (set "RelativeScale3D" "(X=0.222500,Y=0.222500,Z=0.222500)"))))
  (graph "EventGraph"
    (node "K2Node_Event_0" "Event BeginPlay" (pos 0 0)
      (pin out "OutputDelegate" "Delegate")
      (pin out "then" "Exec"))
    (node "K2Node_Event_1" "Event ActorBeginOverlap" (pos 0 208)
      (pin out "OutputDelegate" "Delegate")
      (pin out "then" "Exec")
      (pin out "OtherActor" "Actor Object Reference"))
    (node "K2Node_Event_2" "Event Tick" (pos 0 416)
      (pin out "OutputDelegate" "Delegate")
      (pin out "then" "Exec")
      (pin out "DeltaSeconds" "Float (single-precision)" (default "0.0"))))
  (graph "UserConstructionScript"
    (node "K2Node_FunctionEntry_0" "Construction Script" (pos 0 0)
      (pin out "then" "Exec"))))
