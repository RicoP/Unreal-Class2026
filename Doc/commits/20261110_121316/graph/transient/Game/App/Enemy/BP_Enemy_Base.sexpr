(blueprint-diff "/Game/App/Enemy/BP_Enemy_Base"
  (old (revision "c9c2541d") (date "2026-11-09T09:57:38.000Z") (description "Give the enemies Kenney characters with shared animations\n\n- Import Kenney's mini characters: character-female-a.fbx with its\n  Skeleton and 32 animations, then 18 more characters as meshes only,\n  sharing that Skeleton and the colormap material.\n- BP_Enemy_Base uses character-female-a (capsule and mesh offset fitted),\n  BP_Enemy_Variant1 the zombie.\n- Lvl_ThirdPerson: level geometry changes (documented as a screenshot).\n- Doc/commits/20261109_105725: documentation of this step.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>"))
  (new working-copy)
  (parent "/Script/Engine.Character")
  (components
    (component "CapsuleComponent" (class "CapsuleComponent") (kind native)
      (properties
        (changed "BodyInstance CollisionProfileName" (old "Pawn") (new "Custom"))
        (changed "BodyInstance CollisionResponses" (old "(ResponseArray=((Channel=\"Visibility\",Response=ECR_Ignore)))") (new "(ResponseArray=((Channel=\"Visibility\",Response=ECR_Ignore),(Channel=\"Camera\",Response=ECR_Ignore)))"))))
    (component "Mesh" (class "SkeletalMeshComponent") (kind native)
      (properties
        (changed "BodyInstance CollisionProfileName" (old "CharacterMesh") (new "Custom"))
        (changed "BodyInstance CollisionResponses" (old "(ResponseArray=((Channel=\"Pawn\",Response=ECR_Ignore),(Channel=\"Visibility\",Response=ECR_Ignore),(Channel=\"Vehicle\",Response=ECR_Ignore)))") (new "(ResponseArray=((Channel=\"Pawn\",Response=ECR_Ignore),(Channel=\"Visibility\",Response=ECR_Ignore),(Channel=\"Vehicle\",Response=ECR_Ignore),(Channel=\"WorldStatic\",Response=ECR_Ignore),(Channel=\"WorldDynamic\",Response=ECR_Ignore),(Channel=\"Camera\",Response=ECR_Ignore),(Channel=\"PhysicsBody\",Response=ECR_Ignore),(Channel=\"Destructible\",Response=ECR_Ignore)))"))))))
