(blueprint-diff "/Game/App/Enemy/BP_Enemy_Base"
  (old (revision "02e9a403") (date "2026-11-15T07:47:06.000Z") (description "Spawn a hitbox from the attack animation\n\n- BP_Hero: new child of BP_ThirdPersonCharacter and the pawn of the new\n  BP_AppGameMode. The weapon pickup moved here from the parent, the picked\n  up weapon is kept in Active Weapon, and the pure function\n  GetWeaponHitBoxPoint returns where it is.\n- BP_HitBox_Base: an Actor with a capsule that destroys itself after\n  Lifetime seconds; BP_HitBox_Sword is its child.\n- BP_AnimNotify_Spawn_HitBox: an Anim Notify that spawns Actor To Spawn at\n  the hero's weapon hitbox point. It sits on MM_Attack_01_Montage at\n  0.412 s and spawns BP_HitBox_Sword.\n- BP_Enemy_Base: takes hits from a BP_HitBox_Base instead of the weapon\n  itself.\n- BP_ThirdPersonCharacter: the weapon pickup is gone (now in BP_Hero).\n- Lvl_ThirdPerson: saved with this step; its changes aren't documented.\n- Doc/commits/20261115_084649: documentation of this step.\n\nCo-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>"))
  (new working-copy)
  (parent "/Script/Engine.Character")
  (variables
    (added "Target" (type "BP Hero Object Reference") (category "Default") (default "") (instance-editable false)))
  (functions
    (added "Set Target" (override false) (pure false) (const false) (access "Public") (category "") (inputs (param "Hero" (type "BP Hero Object Reference") (default "")) (param "Seen" (type "Boolean") (default ""))) (outputs)))
  (defaults
    (added "Target" (old none) (new "None"))
    (changed "AIControllerClass" (old "/Script/CoreUObject.Class'/Script/AIModule.AIController'") (new "/Script/Engine.BlueprintGeneratedClass'/Game/App/Enemy/BP_Enemy_AIController.BP_Enemy_AIController_C'")))
  (graph "EventGraph"
