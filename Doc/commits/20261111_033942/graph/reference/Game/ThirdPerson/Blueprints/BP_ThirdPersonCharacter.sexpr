        (set "bOrientRotationToMovement" "True")
        (set "NavMovementProperties FixedPathBrakingDistance" "200.000000")
        (set "NavMovementProperties bUseAccelerationForPaths" "True")
        (set "NavMovementProperties bUseFixedBrakingDistanceForPaths" "True")
        (set "NavAgentProps AgentRadius" "42.000000")
        (set "NavAgentProps AgentHeight" "192.000000")))
    (component "FollowCamera" (class "CameraComponent") (kind added) (attach-to "CameraBoom")
