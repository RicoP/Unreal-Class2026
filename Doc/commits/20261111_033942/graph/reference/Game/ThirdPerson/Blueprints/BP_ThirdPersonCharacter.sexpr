        (set "BrakingDecelerationFalling" "1500.000000")
        (set "AirControl" "0.350000")
        (set "PerchRadiusThreshold" "15.000000")
        (set "RotationRate" "(Pitch=0.000000,Yaw=500.000000,Roll=0.000000)")
