(blueprint "/Game/ThirdPerson/Blueprints/BP_ThirdPersonCharacter"
  (revision working-copy)
  (parent "/Script/Engine.Character")
  (variables
    (variable "NewVar" (type "Boolean") (category "Default") (default "") (instance-editable false)))
