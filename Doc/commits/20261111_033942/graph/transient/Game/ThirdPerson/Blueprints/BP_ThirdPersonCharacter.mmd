---
config:
  look: classic
  themeCSS: "g.node *, g.cluster * { filter: none !important; }"
  flowchart:
    curve: monotoneX
    nodeSpacing: 20
    rankSpacing: 60
    subGraphTitleMargin:
      top: 4
      bottom: 4
---
flowchart LR

    subgraph C_EventGraph_EdGraphNode_Comment_0["Drag in CharacterMesh0 from the Components view"]
        direction LR
        subgraph N_EventGraph_K2Node_VariableGet_3["Get Mesh"]
        end
    end
    subgraph N_EventGraph_K2Node_Event_0["◆ Event ActorBeginOverlap"]
        N_EventGraph_K2Node_Event_0_anchor_in[" "]
        N_EventGraph_K2Node_Event_0_anchor_out[" "]
        N_EventGraph_K2Node_Event_0_OtherActor["<span style='display:inline-block;min-width:150px;text-align:right'>Other Actor ●</span>"]
    end
    subgraph N_EventGraph_K2Node_DynamicCast_0["Cast To BP_Weapon_Base"]
        N_EventGraph_K2Node_DynamicCast_0_anchor_in[" "]
        N_EventGraph_K2Node_DynamicCast_0_Object["<span style='display:inline-block;min-width:150px;text-align:left'>● Object</span>"]
        N_EventGraph_K2Node_DynamicCast_0_then>"<span style='display:inline-block;min-width:150px;text-align:right'>Then ▶</span>"]
        N_EventGraph_K2Node_DynamicCast_0_AsBP_Weapon_Base["<span style='display:inline-block;min-width:150px;text-align:right'>AsBP Weapon Base ●</span>"]
    end
    subgraph N_EventGraph_K2Node_CallFunction_6["Attach Actor To Component"]
        N_EventGraph_K2Node_CallFunction_6_anchor_in[" "]
        N_EventGraph_K2Node_CallFunction_6_anchor_out[" "]
        N_EventGraph_K2Node_CallFunction_6_self["<span style='display:inline-block;min-width:150px;text-align:left'>● Target</span>"]
        N_EventGraph_K2Node_CallFunction_6_Parent["<span style='display:inline-block;min-width:150px;text-align:left'>● Parent</span>"]
        N_EventGraph_K2Node_CallFunction_6_SocketName["<span style='display:inline-block;min-width:150px;text-align:left'><span style='border:1px solid currentColor;border-radius:3px;padding:0 5px'>HandGrip_R</span> Socket Name</span>"]
        N_EventGraph_K2Node_CallFunction_6_LocationRule["<span style='display:inline-block;min-width:150px;text-align:left'><span style='border:1px solid currentColor;border-radius:3px;padding:0 5px'>SnapToTarget</span> Location Rule</span>"]
        N_EventGraph_K2Node_CallFunction_6_RotationRule["<span style='display:inline-block;min-width:150px;text-align:left'><span style='border:1px solid currentColor;border-radius:3px;padding:0 5px'>KeepRelative</span> Rotation Rule</span>"]
        N_EventGraph_K2Node_CallFunction_6_ScaleRule["<span style='display:inline-block;min-width:150px;text-align:left'><span style='border:1px solid currentColor;border-radius:3px;padding:0 5px'>SnapToTarget</span> Scale Rule</span>"]
        N_EventGraph_K2Node_CallFunction_6_bWeldSimulatedBodies["<span style='display:inline-block;min-width:150px;text-align:left'><span style='border:1px solid currentColor;border-radius:3px;padding:0 5px'>TRUE</span> Weld Simulated Bodies</span>"]
    end

    %% Wires
    N_EventGraph_K2Node_Event_0_OtherActor --> N_EventGraph_K2Node_DynamicCast_0_Object
    N_EventGraph_K2Node_Event_0_anchor_out ==> N_EventGraph_K2Node_DynamicCast_0_anchor_in
    N_EventGraph_K2Node_DynamicCast_0_AsBP_Weapon_Base --> N_EventGraph_K2Node_CallFunction_6_self
    N_EventGraph_K2Node_DynamicCast_0_then ==> N_EventGraph_K2Node_CallFunction_6_anchor_in
    N_EventGraph_K2Node_VariableGet_3 --> N_EventGraph_K2Node_CallFunction_6_Parent

    %% Keep inputs left of outputs inside each node
    N_EventGraph_K2Node_Event_0_anchor_in ~~~ N_EventGraph_K2Node_Event_0_OtherActor
    N_EventGraph_K2Node_Event_0_anchor_in ~~~ N_EventGraph_K2Node_Event_0_anchor_out
    N_EventGraph_K2Node_DynamicCast_0_Object ~~~ N_EventGraph_K2Node_DynamicCast_0_then
    N_EventGraph_K2Node_DynamicCast_0_Object ~~~ N_EventGraph_K2Node_DynamicCast_0_AsBP_Weapon_Base
    N_EventGraph_K2Node_DynamicCast_0_anchor_in ~~~ N_EventGraph_K2Node_DynamicCast_0_then
    N_EventGraph_K2Node_DynamicCast_0_anchor_in ~~~ N_EventGraph_K2Node_DynamicCast_0_AsBP_Weapon_Base
    N_EventGraph_K2Node_CallFunction_6_self ~~~ N_EventGraph_K2Node_CallFunction_6_anchor_out
    N_EventGraph_K2Node_CallFunction_6_Parent ~~~ N_EventGraph_K2Node_CallFunction_6_anchor_out
    N_EventGraph_K2Node_CallFunction_6_SocketName ~~~ N_EventGraph_K2Node_CallFunction_6_anchor_out
    N_EventGraph_K2Node_CallFunction_6_LocationRule ~~~ N_EventGraph_K2Node_CallFunction_6_anchor_out
    N_EventGraph_K2Node_CallFunction_6_RotationRule ~~~ N_EventGraph_K2Node_CallFunction_6_anchor_out
    N_EventGraph_K2Node_CallFunction_6_ScaleRule ~~~ N_EventGraph_K2Node_CallFunction_6_anchor_out
    N_EventGraph_K2Node_CallFunction_6_bWeldSimulatedBodies ~~~ N_EventGraph_K2Node_CallFunction_6_anchor_out
    N_EventGraph_K2Node_CallFunction_6_anchor_in ~~~ N_EventGraph_K2Node_CallFunction_6_anchor_out

    %% Nodes
    style N_EventGraph_K2Node_Event_0 fill:#151515,stroke:#b3261e,stroke-width:3px,color:#f2f2f2
    style N_EventGraph_K2Node_DynamicCast_0 fill:#151515,stroke:#8a8a8a,stroke-width:2px,color:#f2f2f2
    style N_EventGraph_K2Node_VariableGet_3 fill:#151515,stroke:#00aaf5,stroke-width:2px,color:#00aaf5,rx:16px,ry:16px
    style N_EventGraph_K2Node_CallFunction_6 fill:#151515,stroke:#456980,stroke-width:2px,color:#f2f2f2
    style C_EventGraph_EdGraphNode_Comment_0 fill:none,stroke:#6c6c6c,stroke-width:2px,color:#6c6c6c

    %% Pins
    classDef pin_anchor fill:#151515,stroke:#151515,color:#151515
    classDef pin_boolean fill:#151515,stroke:#151515,color:#950000
    classDef pin_exec fill:#151515,stroke:#151515,color:#ffffff
    classDef pin_name fill:#151515,stroke:#151515,color:#cd82ff
    classDef pin_object fill:#151515,stroke:#151515,color:#00aaf5
    classDef pin_other fill:#151515,stroke:#151515,color:#777777
    class N_EventGraph_K2Node_Event_0_anchor_in,N_EventGraph_K2Node_Event_0_anchor_out,N_EventGraph_K2Node_DynamicCast_0_anchor_in,N_EventGraph_K2Node_CallFunction_6_anchor_in,N_EventGraph_K2Node_CallFunction_6_anchor_out pin_anchor
    class N_EventGraph_K2Node_CallFunction_6_bWeldSimulatedBodies pin_boolean
    class N_EventGraph_K2Node_DynamicCast_0_then pin_exec
    class N_EventGraph_K2Node_CallFunction_6_SocketName pin_name
    class N_EventGraph_K2Node_Event_0_OtherActor,N_EventGraph_K2Node_DynamicCast_0_Object,N_EventGraph_K2Node_DynamicCast_0_AsBP_Weapon_Base,N_EventGraph_K2Node_CallFunction_6_self,N_EventGraph_K2Node_CallFunction_6_Parent pin_object
    class N_EventGraph_K2Node_CallFunction_6_LocationRule,N_EventGraph_K2Node_CallFunction_6_RotationRule,N_EventGraph_K2Node_CallFunction_6_ScaleRule pin_other

    %% Wire colours (dimmed and dashed between two nodes that aren't part of the change)
    linkStyle 1,3 stroke:#ffffff,stroke-width:3px
    linkStyle 0,2,4 stroke:#00aaf5,stroke-width:2px
