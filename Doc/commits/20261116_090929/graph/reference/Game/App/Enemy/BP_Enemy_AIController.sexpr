(blueprint "/Game/App/Enemy/BP_Enemy_AIController"
  (revision working-copy)
  (parent "/Script/AIModule.AIController")
  (variables)
  (functions)
  (components
    (component "AIPerception" (class "AIPerceptionComponent") (kind added)
      (properties
        (set "SensesConfig" "(\"/Script/AIModule.AISenseConfig_Sight'/Game/App/Enemy/BP_Enemy_AIController.BP_Enemy_AIController_C:AIPerception_GEN_VARIABLE.AISenseConfig_Sight_0'\")")
        (set "SensesConfig AI_Sight_config Sight_Radius" "1500.000000")
        (set "SensesConfig AI_Sight_config Lose_Sight_Radius" "1800.000000")
        (set "SensesConfig AI_Sight_config Peripheral_Vision_Half_Angle" "75.000000")
        (set "SensesConfig AI_Sight_config Detect_Neutrals" "True")
        (set "SensesConfig AI_Sight_config Detect_Friendlies" "True")
        (set "SensesConfig AI_Sight_config Max_Age" "1.000000"))))
  (graph "EventGraph"
    (node "K2Node_CallFunction_0" "Get Controlled Pawn" (pos 464 624)
      (pin in "self" "Controller Object Reference")
      (pin out "ReturnValue" "Pawn Object Reference" (links (pin "K2Node_DynamicCast_1" "Object"))))
    (node "K2Node_CallFunction_1" "Set Target" (pos 1120 448)
      (pin in "execute" "Exec" (links (pin "K2Node_DynamicCast_0" "then")))
      (pin out "then" "Exec")
      (pin in "self" "BP Enemy Base Object Reference" (links (pin "K2Node_DynamicCast_1" "AsBP Enemy Base")))
      (pin in "Hero" "BP Hero Object Reference" (links (pin "K2Node_DynamicCast_0" "AsBP Hero")))
      (pin in "Seen" "Boolean" (links (pin "K2Node_Knot_1" "OutputPin"))))
    (node "K2Node_ComponentBoundEvent_0" "On Target Perception Updated (AIPerception)" (pos -224 464)
      (pin out "OutputDelegate" "Delegate")
      (pin out "then" "Exec" (links (pin "K2Node_DynamicCast_0" "execute")))
      (pin out "Actor" "Actor Object Reference" (links (pin "K2Node_DynamicCast_0" "Object")))
      (pin out "Stimulus_Age" "Float (single-precision)")
      (pin out "Stimulus_ExpirationAge" "Float (single-precision)")
      (pin out "Stimulus_Strength" "Float (single-precision)")
      (pin out "Stimulus_StimulusLocation" "Vector")
      (pin out "Stimulus_ReceiverLocation" "Vector")
      (pin out "Stimulus_Tag" "Name")
      (pin out "Stimulus_bSuccessfullySensed" "Boolean" (links (pin "K2Node_Knot_1" "InputPin"))))
    (node "K2Node_DynamicCast_0" "Cast To BP_Hero" (pos 304 464)
      (pin in "execute" "Exec" (links (pin "K2Node_ComponentBoundEvent_0" "then")))
      (pin out "then" "Exec" (links (pin "K2Node_CallFunction_1" "execute")))
      (pin out "CastFailed" "Exec")
      (pin in "Object" "Object Reference" (links (pin "K2Node_ComponentBoundEvent_0" "Actor")))
      (pin out "AsBP Hero" "BP Hero Object Reference" (links (pin "K2Node_CallFunction_1" "Hero"))))
    (node "K2Node_DynamicCast_1" "Cast To BP_Enemy_Base" (pos 736 640)
      (pin in "Object" "Object Reference" (links (pin "K2Node_CallFunction_0" "ReturnValue")))
      (pin out "AsBP Enemy Base" "BP Enemy Base Object Reference" (links (pin "K2Node_CallFunction_1" "self")))
      (pin out "bSuccess" "Boolean"))
    (node "K2Node_Event_0" "Event BeginPlay" (pos 0 0)
      (pin out "OutputDelegate" "Delegate")
      (pin out "then" "Exec"))
    (node "K2Node_Event_1" "Event Tick" (pos 0 208)
      (pin out "OutputDelegate" "Delegate")
      (pin out "then" "Exec")
      (pin out "DeltaSeconds" "Float (single-precision)" (default "0.0")))
    (node "K2Node_Knot_1" "Reroute Node" (pos 432 592)
      (pin in "InputPin" "Boolean" (links (pin "K2Node_ComponentBoundEvent_0" "Stimulus_bSuccessfullySensed")))
      (pin out "OutputPin" "Boolean" (links (pin "K2Node_CallFunction_1" "Seen")))))
  (graph "UserConstructionScript"
    (node "K2Node_FunctionEntry_0" "Construction Script" (pos 0 0)
      (pin out "then" "Exec"))))
