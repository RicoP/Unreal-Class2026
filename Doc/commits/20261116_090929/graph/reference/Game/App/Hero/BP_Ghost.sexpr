(blueprint "/Game/App/Hero/BP_Ghost"
  (revision working-copy)
  (parent "/Script/Engine.Character")
  (variables)
  (functions)
  (defaults (baseline parent-class)
    (set "AutoPossessAI" "PlacedInWorldOrSpawned")
    (set "AIControllerClass" "/Script/Engine.BlueprintGeneratedClass'/Game/App/Hero/BP_Ghost_AIController.BP_Ghost_AIController_C'"))
  (components
    (component "CapsuleComponent" (class "CapsuleComponent") (kind native)
      (properties
        (set "BodyInstance ObjectType" "ECC_WorldDynamic")
        (set "BodyInstance CollisionEnabled" "QueryOnly")
        (set "BodyInstance CollisionProfileName" "Custom")
        (set "BodyInstance CollisionResponses" "(ResponseArray=((Channel=\"Pawn\",Response=ECR_Ignore),(Channel=\"Vehicle\",Response=ECR_Ignore),(Channel=\"Camera\",Response=ECR_Ignore),(Channel=\"Visibility\",Response=ECR_Ignore),(Channel=\"PhysicsBody\",Response=ECR_Ignore),(Channel=\"Destructible\",Response=ECR_Ignore)))")))
    (component "Mesh" (class "SkeletalMeshComponent") (kind native)
      (properties
        (set "SkeletalMeshAsset" "/Script/Engine.SkeletalMesh'/Engine/Tutorial/SubEditors/TutorialAssets/Character/TutorialTPP.TutorialTPP'")
        (set "SkeletalMesh" "/Script/Engine.SkeletalMesh'/Engine/Tutorial/SubEditors/TutorialAssets/Character/TutorialTPP.TutorialTPP'")
        (set "BodyInstance ObjectType" "ECC_WorldStatic")
        (set "BodyInstance CollisionEnabled" "NoCollision")
        (set "BodyInstance CollisionProfileName" "Custom")
        (set "BodyInstance CollisionResponses" "(ResponseArray=((Channel=\"Visibility\",Response=ECR_Ignore),(Channel=\"Camera\",Response=ECR_Ignore),(Channel=\"WorldStatic\",Response=ECR_Ignore),(Channel=\"WorldDynamic\",Response=ECR_Ignore),(Channel=\"Pawn\",Response=ECR_Ignore),(Channel=\"PhysicsBody\",Response=ECR_Ignore),(Channel=\"Vehicle\",Response=ECR_Ignore),(Channel=\"Destructible\",Response=ECR_Ignore)))")
        (set "RelativeLocation" "(X=0.000000,Y=0.000000,Z=-88.948120)")
        (set "RelativeRotation" "(Pitch=0.000000,Yaw=-90.000000,Roll=0.000000)"))))
  (graph "EventGraph"
    (node "K2Node_Event_0" "Event BeginPlay" (pos 0 0)
      (pin out "OutputDelegate" "Delegate")
      (pin out "then" "Exec"))
    (node "K2Node_Event_1" "Event ActorBeginOverlap" (pos 0 208)
      (pin out "OutputDelegate" "Delegate")
      (pin out "then" "Exec")
      (pin out "OtherActor" "Actor Object Reference"))
    (node "K2Node_Event_2" "Event Tick" (pos 0 416)
      (pin out "OutputDelegate" "Delegate")
      (pin out "then" "Exec")
      (pin out "DeltaSeconds" "Float (single-precision)" (default "0.0"))))
  (graph "UserConstructionScript"
    (node "K2Node_FunctionEntry_0" "Construction Script" (pos 0 0)
      (pin out "then" "Exec"))))
