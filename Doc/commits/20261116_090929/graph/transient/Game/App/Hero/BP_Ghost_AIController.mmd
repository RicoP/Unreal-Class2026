    N_EventGraph_K2Node_CallFunction_1_self ~~~ N_EventGraph_K2Node_CallFunction_1_anchor_out
    N_EventGraph_K2Node_CallFunction_1_WorldDirection ~~~ N_EventGraph_K2Node_CallFunction_1_anchor_out
    N_EventGraph_K2Node_CallFunction_1_ScaleValue ~~~ N_EventGraph_K2Node_CallFunction_1_anchor_out
    N_EventGraph_K2Node_CallFunction_1_anchor_in ~~~ N_EventGraph_K2Node_CallFunction_1_anchor_out

    %% Nodes
    style N_EventGraph_K2Node_CallFunction_0 fill:#151515,stroke:#00aaf5,stroke-width:2px,color:#00aaf5,rx:16px,ry:16px
    style N_EventGraph_K2Node_Event_1 fill:#151515,stroke:#b3261e,stroke-width:3px,color:#f2f2f2
    style N_EventGraph_K2Node_MacroInstance_0 fill:#151515,stroke:#8a8a8a,stroke-width:2px,color:#f2f2f2
    style N_EventGraph_K2Node_CallFunction_2 fill:#151515,stroke:#ffca23,stroke-width:2px,color:#ffca23,rx:16px,ry:16px
    style N_EventGraph_K2Node_CallFunction_1 fill:#151515,stroke:#456980,stroke-width:2px,color:#f2f2f2

    %% Pins
    classDef pin_anchor fill:#151515,stroke:#151515,color:#151515
    classDef pin_exec fill:#151515,stroke:#151515,color:#ffffff
    classDef pin_float fill:#151515,stroke:#151515,color:#38d500
    classDef pin_object fill:#151515,stroke:#151515,color:#00aaf5
    classDef pin_vector fill:#151515,stroke:#151515,color:#ffca23
    class N_EventGraph_K2Node_MacroInstance_0_anchor_in,N_EventGraph_K2Node_CallFunction_1_anchor_in,N_EventGraph_K2Node_CallFunction_1_anchor_out pin_anchor
    class N_EventGraph_K2Node_MacroInstance_0_Is_Valid pin_exec
    class N_EventGraph_K2Node_CallFunction_1_ScaleValue pin_float
    class N_EventGraph_K2Node_MacroInstance_0_InputObject,N_EventGraph_K2Node_CallFunction_1_self pin_object
    class N_EventGraph_K2Node_CallFunction_1_WorldDirection pin_vector

    %% Wire colours (dimmed and dashed between two nodes that aren't part of the change)
    linkStyle 3,4 stroke:#ffffff,stroke-width:3px
