(blueprint "/Game/App/Enemy/BP_Enemy_Base"
  (revision working-copy)
  (parent "/Script/Engine.Character")
  (variables
    (variable "AI Timer Handle" (type "Timer Handle Structure") (category "Default") (default "") (instance-editable false))
    (variable "Life" (type "Integer") (category "Default") (default "") (instance-editable false)))
  (defaults (baseline parent-class)
    (set "AutoPossessAI" "PlacedInWorldOrSpawned"))
  (components
    (component "CapsuleComponent" (class "CapsuleComponent") (kind native)
      (properties
        (set "CapsuleHalfHeight" "52.171066")
        (set "BodyInstance CollisionProfileName" "Custom")
        (set "BodyInstance CollisionResponses" "(ResponseArray=((Channel=\"Visibility\",Response=ECR_Ignore),(Channel=\"Camera\",Response=ECR_Ignore)))")))
    (component "CharacterMovement" (class "CharacterMovementComponent") (kind native)
      (properties
        (set "MaxWalkSpeed" "450.000000")
        (set "bOrientRotationToMovement" "True")))
    (component "Mesh" (class "SkeletalMeshComponent") (kind native)
      (properties
        (set "SkeletalMeshAsset" "/Script/Engine.SkeletalMesh'/Game/Kenney-Assets/mini-characters/SkeletalMeshes/character-female-a.character-female-a'")
        (set "AnimClass" "/Script/Engine.AnimBlueprintGeneratedClass'/Game/App/Enemy/ABP_Enemy_Base.ABP_Enemy_Base_C'")
        (set "SkeletalMesh" "/Script/Engine.SkeletalMesh'/Game/Kenney-Assets/mini-characters/SkeletalMeshes/character-female-a.character-female-a'")
        (set "BodyInstance CollisionProfileName" "Custom")
        (set "BodyInstance CollisionResponses" "(ResponseArray=((Channel=\"Pawn\",Response=ECR_Ignore),(Channel=\"Visibility\",Response=ECR_Ignore),(Channel=\"Vehicle\",Response=ECR_Ignore),(Channel=\"WorldStatic\",Response=ECR_Ignore),(Channel=\"WorldDynamic\",Response=ECR_Ignore),(Channel=\"Camera\",Response=ECR_Ignore),(Channel=\"PhysicsBody\",Response=ECR_Ignore),(Channel=\"Destructible\",Response=ECR_Ignore)))")
        (set "RelativeLocation" "(X=0.000000,Y=0.000000,Z=-52.560431)")
        (set "RelativeRotation" "(Pitch=0.000000,Yaw=270.000000,Roll=0.000000)"))))
  (graph "EventGraph"
    (node "K2Node_AIMoveTo_0" "AI MoveTo" (pos -80 448)
      (pin in "execute" "Exec" (links (pin "K2Node_CustomEvent_0" "then")))
      (pin out "then" "Exec")
      (pin out "OnSuccess" "Exec")
      (pin out "OnFail" "Exec")
      (pin out "MovementResult" "EPathFollowingResult Enum")
      (pin in "Pawn" "Pawn Object Reference" (links (pin "K2Node_Self_0" "self")))
      (pin in "Destination" "Vector" (default "0, 0, 0"))
      (pin in "TargetActor" "Actor Object Reference" (links (pin "K2Node_CallFunction_2" "ReturnValue")))
      (pin in "AcceptanceRadius" "Float (single-precision)" (default "50.000000"))
      (pin in "bStopOnOverlap" "Boolean" (default "false")))
    (node "K2Node_CallFunction_1" "Set Timer by Event" (pos -224 16)
      (pin in "execute" "Exec" (links (pin "K2Node_Event_0" "then")))
      (pin out "then" "Exec" (links (pin "K2Node_VariableSet_0" "execute")))
      (pin in "Delegate" "Delegate" (links (pin "K2Node_CustomEvent_0" "OutputDelegate")))
      (pin in "Time" "Float (single-precision)" (default "0.500000"))
      (pin in "bLooping" "Boolean" (default "true"))
      (pin in "bMaxOncePerFrame" "Boolean" (default "false"))
      (pin in "InitialStartDelay" "Float (single-precision)" (default "0.000000"))
      (pin in "InitialStartDelayVariance" "Float (single-precision)" (default "0.200000"))
      (pin out "ReturnValue" "Timer Handle Structure" (links (pin "K2Node_VariableSet_0" "AI Timer Handle"))))
    (node "K2Node_CallFunction_2" "GetPlayerCharacter" (pos -368 640)
      (pin in "PlayerIndex" "Integer" (default "0"))
      (pin out "ReturnValue" "Character Object Reference" (links (pin "K2Node_AIMoveTo_0" "TargetActor"))))
    (node "K2Node_CustomEvent_0" "CustomEvent" (pos -464 432)
      (pin out "OutputDelegate" "Delegate" (links (pin "K2Node_CallFunction_1" "Delegate")))
      (pin out "then" "Exec" (links (pin "K2Node_AIMoveTo_0" "execute"))))
    (node "K2Node_Event_0" "Event BeginPlay" (pos -480 16)
      (pin out "OutputDelegate" "Delegate")
      (pin out "then" "Exec" (links (pin "K2Node_CallFunction_1" "execute"))))
    (node "K2Node_Self_0" "Self-Reference" (pos -272 560)
      (pin out "self" "Self Object Reference" (links (pin "K2Node_AIMoveTo_0" "Pawn"))))
    (node "K2Node_VariableSet_0" "Set AI Timer Handle" (pos 160 32)
      (pin in "execute" "Exec" (links (pin "K2Node_CallFunction_1" "then")))
      (pin out "then" "Exec")
      (pin in "AI Timer Handle" "Timer Handle Structure" (links (pin "K2Node_CallFunction_1" "ReturnValue")))
      (pin out "Output_Get" "Timer Handle Structure")))
  (graph "EventGraph Hit"
    (node "K2Node_CallFunction_3" "Clear and Invalidate Timer by Handle" (pos 400 384)
      (pin in "execute" "Exec" (links (pin "K2Node_IfThenElse_0" "then")))
      (pin out "then" "Exec" (links (pin "K2Node_PlayMontage_0" "execute")))
      (pin in "Handle" "Timer Handle Structure (by ref)" (links (pin "K2Node_VariableGet_0" "AI Timer Handle"))))
    (node "K2Node_CallFunction_6" "SetCollisionResponseToChannel" (pos 1744 368)
      (pin in "execute" "Exec" (links (pin "K2Node_VariableSet_1" "then")))
      (pin out "then" "Exec")
      (pin in "self" "Primitive Component Object Reference" (links (pin "K2Node_VariableGet_3" "CapsuleComponent")))
      (pin in "Channel" "ECollisionChannel Enum" (default "ECC_Pawn"))
      (pin in "NewResponse" "ECollisionResponse Enum" (default "ECR_Ignore")))
    (node "K2Node_DynamicCast_0" "Cast To BP_Weapon_Base" (pos -448 384)
      (pin in "execute" "Exec" (links (pin "K2Node_Event_1" "then")))
      (pin out "then" "Exec" (links (pin "K2Node_IfThenElse_0" "execute")))
      (pin out "CastFailed" "Exec")
      (pin in "Object" "Object Reference" (links (pin "K2Node_Event_1" "OtherActor")))
      (pin out "AsBP Weapon Base" "BP Weapon Base Object Reference"))
    (node "K2Node_Event_1" "Event ActorBeginOverlap" (pos -720 384)
      (pin out "OutputDelegate" "Delegate")
      (pin out "then" "Exec" (links (pin "K2Node_DynamicCast_0" "execute")))
      (pin out "OtherActor" "Actor Object Reference" (links (pin "K2Node_DynamicCast_0" "Object"))))
    (node "K2Node_IfThenElse_0" "Branch" (pos -80 384)
      (pin in "execute" "Exec" (links (pin "K2Node_DynamicCast_0" "then")))
      (pin in "Condition" "Boolean" (links (pin "K2Node_PromotableOperator_0" "ReturnValue")))
      (pin out "then" "Exec" (links (pin "K2Node_CallFunction_3" "execute")))
      (pin out "else" "Exec"))
    (node "K2Node_PlayMontage_0" "Play Montage" (pos 880 384)
      (pin in "execute" "Exec" (links (pin "K2Node_CallFunction_3" "then")))
      (pin out "then" "Exec" (links (pin "K2Node_VariableSet_1" "execute")))
      (pin out "OnCompleted" "Exec")
      (pin out "OnBlendOut" "Exec")
      (pin out "OnInterrupted" "Exec")
      (pin out "OnNotifyBegin" "Exec")
      (pin out "OnNotifyEnd" "Exec")
      (pin out "NotifyName" "Name")
      (pin in "InSkeletalMeshComponent" "Skeletal Mesh Component Object Reference" (links (pin "K2Node_VariableGet_1" "Mesh")))
      (pin in "MontageToPlay" "Anim Montage Object Reference")
      (pin in "PlayRate" "Float (single-precision)" (default "1.000000"))
      (pin in "StartingPosition" "Float (single-precision)" (default "0.000000"))
      (pin in "StartingSection" "Name" (default "None"))
      (pin in "bShouldStopAllMontages" "Boolean" (default "true")))
    (node "K2Node_PromotableOperator_0" "integer > integer" (pos -256 576)
      (pin in "A" "Integer" (links (pin "K2Node_VariableGet_2" "Life")))
      (pin in "B" "Integer")
      (pin out "ReturnValue" "Boolean" (links (pin "K2Node_IfThenElse_0" "Condition"))))
    (node "K2Node_VariableGet_0" "Get AI Timer Handle" (pos 176 608)
      (pin out "AI Timer Handle" "Timer Handle Structure" (links (pin "K2Node_CallFunction_3" "Handle"))))
    (node "K2Node_VariableGet_1" "Get Mesh" (pos 640 560)
      (pin out "Mesh" "Skeletal Mesh Component Object Reference" (links (pin "K2Node_PlayMontage_0" "InSkeletalMeshComponent"))))
    (node "K2Node_VariableGet_2" "Get Life" (pos -448 576)
      (pin out "Life" "Integer" (links (pin "K2Node_PromotableOperator_0" "A"))))
    (node "K2Node_VariableGet_3" "Get CapsuleComponent" (pos 1456 592)
      (pin out "CapsuleComponent" "Capsule Collision Object Reference" (links (pin "K2Node_CallFunction_6" "self"))))
    (node "K2Node_VariableSet_1" "Set Life" (pos 1360 400)
      (pin in "execute" "Exec" (links (pin "K2Node_PlayMontage_0" "then")))
      (pin out "then" "Exec" (links (pin "K2Node_CallFunction_6" "execute")))
      (pin in "Life" "Integer" (default "0"))
      (pin out "Output_Get" "Integer" (default "0"))))
  (graph "UserConstructionScript"
    (node "K2Node_FunctionEntry_0" "Construction Script" (pos 0 0)
      (pin out "then" "Exec"))))
