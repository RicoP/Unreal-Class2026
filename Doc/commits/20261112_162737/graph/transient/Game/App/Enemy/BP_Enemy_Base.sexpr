(blueprint-diff "/Game/App/Enemy/BP_Enemy_Base"
  (old (revision "091a9821") (date "2026-11-12T06:12:26.000Z") (description "Animate the enemy with an idle-to-walk blend\n\n- BS_Enemy_Base: Blend Space 1D on character-female-a_Skeleton, idle\n  at the beginning and walk at the end of a Walk Speed axis up to 450.\n- ABP_Enemy_Base: Animation Blueprint that sets Walk Speed from the\n  pawn's horizontal velocity and plays the blend space.\n- BP_Enemy_Base: the Mesh uses ABP_Enemy_Base.\n- Tools/sexpr_to_table.py: Blueprint variables in the settings table;\n  BlendSpace1D samples read \"at Beginning/End of Blend\".\n- Doc/commits/20261112_071214: documentation of this step.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>"))
  (new working-copy)
  (parent "/Script/Engine.Character")
  (variables
    (added "AI Timer Handle" (type "Timer Handle Structure") (category "Default") (default "") (instance-editable false))
    (added "Life" (type "Integer") (category "Default") (default "") (instance-editable false)))
  (defaults
    (added "AI Timer Handle" (old none) (new "()"))
    (added "Life" (old none) (new "100")))
  (graph "EventGraph"
    (pin-links-added addition
      (text "Added Link to 'then'")
      (old-pin (pin "K2Node_CallFunction_1" "then") (links) (default ""))
      (new-pin (pin "K2Node_CallFunction_1" "then") (links (pin "K2Node_VariableSet_0" "execute")) (default "")))
    (pin-links-added addition
      (text "Added Link to 'ReturnValue'")
      (old-pin (pin "K2Node_CallFunction_1" "ReturnValue") (links) (default ""))
      (new-pin (pin "K2Node_CallFunction_1" "ReturnValue") (links (pin "K2Node_VariableSet_0" "AI Timer Handle")) (default "")))
    (node-added addition
      (text "Added Node 'Set AI Timer Handle'")
      (node "K2Node_VariableSet_0" "Set AI Timer Handle" (pos 160 32))
      (pin in "execute" "Exec" (links (pin "K2Node_CallFunction_1" "then")))
      (pin out "then" "Exec")
      (pin in "AI Timer Handle" "Timer Handle Structure" (links (pin "K2Node_CallFunction_1" "ReturnValue")))
      (pin out "Output_Get" "Timer Handle Structure")))
  (graph "EventGraph Hit" added
    (node-added addition
      (node "K2Node_Event_1" "Event ActorBeginOverlap" (pos -720 384))
      (pin out "OutputDelegate" "Delegate")
      (pin out "then" "Exec" (links (pin "K2Node_DynamicCast_0" "execute")))
      (pin out "OtherActor" "Actor Object Reference" (links (pin "K2Node_DynamicCast_0" "Object"))))
    (node-added addition
      (node "K2Node_DynamicCast_0" "Cast To BP_Weapon_Base" (pos -448 384))
      (pin in "execute" "Exec" (links (pin "K2Node_Event_1" "then")))
      (pin out "then" "Exec" (links (pin "K2Node_IfThenElse_0" "execute")))
      (pin out "CastFailed" "Exec")
      (pin in "Object" "Object Reference" (links (pin "K2Node_Event_1" "OtherActor")))
      (pin out "AsBP Weapon Base" "BP Weapon Base Object Reference"))
    (node-added addition
      (node "K2Node_VariableGet_0" "Get AI Timer Handle" (pos 176 608))
      (pin out "AI Timer Handle" "Timer Handle Structure" (links (pin "K2Node_CallFunction_3" "Handle"))))
    (node-added addition
      (node "K2Node_CallFunction_3" "Clear and Invalidate Timer by Handle" (pos 400 384))
      (pin in "execute" "Exec" (links (pin "K2Node_IfThenElse_0" "then")))
      (pin out "then" "Exec" (links (pin "K2Node_PlayMontage_0" "execute")))
      (pin in "Handle" "Timer Handle Structure (by ref)" (links (pin "K2Node_VariableGet_0" "AI Timer Handle"))))
    (node-added addition
