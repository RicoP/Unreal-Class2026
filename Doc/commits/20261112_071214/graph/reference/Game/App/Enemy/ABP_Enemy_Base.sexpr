(blueprint "/Game/App/Enemy/ABP_Enemy_Base"
  (revision working-copy)
  (parent "/Script/Engine.AnimInstance")
  (variables
    (variable "Walk Speed" (type "Float (double-precision)") (category "Default") (default "") (instance-editable false)))
  (graph "AnimGraph"
    (node "AnimGraphNode_BlendSpacePlayer_0" "Blendspace Player 'BS_Enemy_Base'" (pos -368 144)
      (pin in "X" "Float (single-precision)" (links (pin "K2Node_VariableGet_0" "Walk Speed")))
      (pin out "Pose" "Pose Link Structure" (links (pin "AnimGraphNode_Root_0" "Result"))))
    (node "AnimGraphNode_Root_0" "Output Pose" (pos -112 95)
      (pin in "Result" "Pose Link Structure" (links (pin "AnimGraphNode_BlendSpacePlayer_0" "Pose"))))
    (node "K2Node_VariableGet_0" "Get Walk Speed" (pos -528 182)
      (pin out "Walk Speed" "Float (double-precision)" (links (pin "AnimGraphNode_BlendSpacePlayer_0" "X")))))
  (graph "EventGraph"
    (node "EdGraphNode_Comment_0" "Comment" (pos 336 112)
      (comment "Vector Length XY because only speed on the plane counts for animation blend" (size 535 176) (color "#6c6c6c")))
    (node "K2Node_CallFunction_0" "TryGetPawnOwner" (pos 16 176)
      (pin in "self" "Anim Instance Object Reference")
      (pin out "ReturnValue" "Pawn Object Reference" (links (pin "K2Node_MacroInstance_0" "InputObject") (pin "K2Node_CallFunction_1" "self"))))
    (node "K2Node_CallFunction_1" "GetVelocity" (pos 400 176)
      (pin in "self" "Actor Object Reference" (links (pin "K2Node_CallFunction_0" "ReturnValue")))
      (pin out "ReturnValue" "Vector" (links (pin "K2Node_CallFunction_2" "A"))))
    (node "K2Node_CallFunction_2" "Vector Length XY" (pos 656 192)
      (pin in "A" "Vector" (links (pin "K2Node_CallFunction_1" "ReturnValue")))
      (pin out "ReturnValue" "Float (double-precision)" (links (pin "K2Node_VariableSet_0" "Walk Speed"))))
    (node "K2Node_Event_0" "Event BlueprintUpdateAnimation" (pos 0 0)
      (pin out "OutputDelegate" "Delegate")
      (pin out "then" "Exec" (links (pin "K2Node_MacroInstance_0" "exec")))
      (pin out "DeltaTimeX" "Float (single-precision)" (default "0.0")))
    (node "K2Node_MacroInstance_0" "Is Valid" (pos 336 0)
      (pin in "exec" "Exec" (links (pin "K2Node_Event_0" "then")))
      (pin in "InputObject" "Object Reference" (links (pin "K2Node_CallFunction_0" "ReturnValue")))
      (pin out "Is Valid" "Exec" (links (pin "K2Node_VariableSet_0" "execute")))
      (pin out "Is Not Valid" "Exec"))
    (node "K2Node_VariableSet_0" "Set Walk Speed" (pos 1008 16)
      (pin in "execute" "Exec" (links (pin "K2Node_MacroInstance_0" "Is Valid")))
      (pin out "then" "Exec")
      (pin in "Walk Speed" "Float (double-precision)" (links (pin "K2Node_CallFunction_2" "ReturnValue")))
      (pin out "Output_Get" "Float (double-precision)" (default "0.0")))))
