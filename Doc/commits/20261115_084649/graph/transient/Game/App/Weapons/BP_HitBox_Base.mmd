---
config:
  look: classic
  themeCSS: "g.node *, g.cluster * { filter: none !important; }"
  flowchart:
    curve: monotoneX
    nodeSpacing: 8
    rankSpacing: 30
    subGraphTitleMargin:
      top: 4
      bottom: 4
---
flowchart LR

    subgraph N_EventGraph_K2Node_Event_0["◆ Event BeginPlay"]
    end
    subgraph N_EventGraph_K2Node_VariableGet_0["Get Lifetime"]
    end
    subgraph N_EventGraph_K2Node_CallFunction_0["Delay"]
        N_EventGraph_K2Node_CallFunction_0_anchor_in[" "]
        N_EventGraph_K2Node_CallFunction_0_anchor_out[" "]
        N_EventGraph_K2Node_CallFunction_0_Duration["<span style='display:inline-block;min-width:150px;text-align:left'>● Duration</span>"]
    end
    subgraph N_EventGraph_K2Node_CallFunction_1["Destroy Actor"]
    end

    %% Wires
    N_EventGraph_K2Node_Event_0 ==> N_EventGraph_K2Node_CallFunction_0_anchor_in
    N_EventGraph_K2Node_VariableGet_0 --> N_EventGraph_K2Node_CallFunction_0_Duration
    N_EventGraph_K2Node_CallFunction_0_anchor_out ==> N_EventGraph_K2Node_CallFunction_1

    %% Keep inputs left of outputs inside each node
    N_EventGraph_K2Node_CallFunction_0_Duration ~~~ N_EventGraph_K2Node_CallFunction_0_anchor_out
    N_EventGraph_K2Node_CallFunction_0_anchor_in ~~~ N_EventGraph_K2Node_CallFunction_0_anchor_out

    %% Nodes
    style N_EventGraph_K2Node_Event_0 fill:#151515,stroke:#b3261e,stroke-width:3px,color:#f2f2f2
    style N_EventGraph_K2Node_VariableGet_0 fill:#151515,stroke:#38d500,stroke-width:2px,color:#38d500,rx:16px,ry:16px
    style N_EventGraph_K2Node_CallFunction_0 fill:#151515,stroke:#456980,stroke-width:2px,color:#f2f2f2
    style N_EventGraph_K2Node_CallFunction_1 fill:#151515,stroke:#456980,stroke-width:2px,color:#f2f2f2

    %% Pins
    classDef pin_anchor fill:#151515,stroke:#151515,color:#151515
    classDef pin_float fill:#151515,stroke:#151515,color:#38d500
    class N_EventGraph_K2Node_CallFunction_0_anchor_in,N_EventGraph_K2Node_CallFunction_0_anchor_out pin_anchor
    class N_EventGraph_K2Node_CallFunction_0_Duration pin_float

    %% Wire colours (dimmed and dashed between two nodes that aren't part of the change)
    linkStyle 0,2 stroke:#ffffff,stroke-width:3px
    linkStyle 1 stroke:#38d500,stroke-width:2px
