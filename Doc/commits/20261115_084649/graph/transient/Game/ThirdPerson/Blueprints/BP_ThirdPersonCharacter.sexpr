(blueprint-diff "/Game/ThirdPerson/Blueprints/BP_ThirdPersonCharacter"
  (old (revision "0666bd9c") (date "2026-11-12T15:27:49.000Z") (description "Swing at enemies and let them die\n\n- IA_Swing on the left mouse button (IMC_Default); BP_ThirdPersonCharacter\n  plays MM_Attack_01_Montage, guarded by an Is Attacking variable.\n- MM_Attack_01: root motion off and root locked, so the punch plays on\n  the spot.\n- character-female-adie_Montage: holds its last frame (no auto blend\n  out), played at 0.4 speed; ABP_Enemy_Base gets a DefaultSlot node.\n- BP_Enemy_Base: Life (100) and an AI timer handle.\n- Tools/sexpr_to_table.py: leaves out animation bookkeeping and unchanged\n  assets, trims numbers, and documents new assets with default settings.\n- BlueprintDiffExport: montages export their slot tracks (MontageSlots).\n  Not built yet: build with the editor closed.\n- Doc/commits/20261112_162737: documentation of this step.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>"))
  (new working-copy)
  (parent "/Script/Engine.Character")
  (graph "EventGraph"
    (node-removed subtraction
      (text "Removed Node 'Cast To BP_Weapon_Base'")
      (node "K2Node_DynamicCast_0" "Cast To BP_Weapon_Base" (pos -688 -1568))
      (pin in "execute" "Exec" (links (pin "K2Node_Event_0" "then")))
      (pin out "then" "Exec" (links (pin "K2Node_CallFunction_6" "execute")))
      (pin out "CastFailed" "Exec")
      (pin in "Object" "Object Reference" (links (pin "K2Node_Event_0" "OtherActor")))
      (pin out "AsBP Weapon Base" "BP Weapon Base Object Reference" (links (pin "K2Node_CallFunction_6" "self"))))
    (node-removed subtraction
      (text "Removed Node 'Attach Actor To Component'")
      (node "K2Node_CallFunction_6" "Attach Actor To Component" (pos -160 -1376))
      (pin in "execute" "Exec" (links (pin "K2Node_DynamicCast_0" "then")))
      (pin out "then" "Exec")
      (pin in "self" "Actor Object Reference" (links (pin "K2Node_DynamicCast_0" "AsBP Weapon Base")))
      (pin in "Parent" "Scene Component Object Reference" (links (pin "K2Node_VariableGet_3" "Mesh")))
      (pin in "SocketName" "Name" (default "HandGrip_R"))
      (pin in "LocationRule" "EAttachmentRule Enum" (default "SnapToTarget"))
      (pin in "RotationRule" "EAttachmentRule Enum" (default "KeepRelative"))
      (pin in "ScaleRule" "EAttachmentRule Enum" (default "SnapToTarget"))
      (pin in "bWeldSimulatedBodies" "Boolean" (default "TRUE"))
      (pin out "ReturnValue" "Boolean" (default "false")))
