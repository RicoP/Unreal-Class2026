(blueprint "/Game/App/Hero/BP_Ghost"
  (revision working-copy)
  (parent "/Script/Engine.Character")
  (variables)
  (functions)
  (defaults (baseline parent-class)
    (set "AutoPossessAI" "PlacedInWorldOrSpawned" (display "Auto Possess AI"))
    (set "AIControllerClass" "/Script/Engine.BlueprintGeneratedClass'/Game/App/Hero/BP_Ghost_AIController.BP_Ghost_AIController_C'" (display "AI Controller Class")))
  (components
    (component "CapsuleComponent" (class "CapsuleComponent") (kind native)
      (properties
        (set "BodyInstance ObjectType" "ECC_WorldDynamic" (display "Object Type"))
        (set "BodyInstance CollisionEnabled" "QueryOnly" (display "Collision Enabled"))
        (set "BodyInstance CollisionProfileName" "Custom" (display "Collision Profile Name"))
        (set "BodyInstance CollisionResponses" "(ResponseArray=((Channel=\"Pawn\",Response=ECR_Ignore),(Channel=\"Vehicle\",Response=ECR_Ignore),(Channel=\"Camera\",Response=ECR_Ignore),(Channel=\"Visibility\",Response=ECR_Ignore),(Channel=\"PhysicsBody\",Response=ECR_Ignore),(Channel=\"Destructible\",Response=ECR_Ignore)))" (display "Collision Responses"))))
    (component "CharacterMovement" (class "CharacterMovementComponent") (kind native)
      (properties
        (set "bCanWalkOffLedges" "False" (display "Can Walk Off Ledges"))))
    (component "Mesh" (class "SkeletalMeshComponent") (kind native)
      (properties
        (set "SkeletalMeshAsset" "/Script/Engine.SkeletalMesh'/Engine/Tutorial/SubEditors/TutorialAssets/Character/TutorialTPP.TutorialTPP'" (display "Skeletal Mesh Asset"))
        (set "SkeletalMesh" "/Script/Engine.SkeletalMesh'/Engine/Tutorial/SubEditors/TutorialAssets/Character/TutorialTPP.TutorialTPP'" (display "Skeletal Mesh"))
        (set "BodyInstance ObjectType" "ECC_WorldStatic" (display "Object Type"))
        (set "BodyInstance CollisionEnabled" "NoCollision" (display "Collision Enabled"))
        (set "BodyInstance CollisionProfileName" "Custom" (display "Collision Profile Name"))
        (set "BodyInstance CollisionResponses" "(ResponseArray=((Channel=\"Visibility\",Response=ECR_Ignore),(Channel=\"Camera\",Response=ECR_Ignore),(Channel=\"WorldStatic\",Response=ECR_Ignore),(Channel=\"WorldDynamic\",Response=ECR_Ignore),(Channel=\"Pawn\",Response=ECR_Ignore),(Channel=\"PhysicsBody\",Response=ECR_Ignore),(Channel=\"Vehicle\",Response=ECR_Ignore),(Channel=\"Destructible\",Response=ECR_Ignore)))" (display "Collision Responses"))
        (set "RelativeLocation" "(X=0.000000,Y=0.000000,Z=-88.948120)" (display "Relative Location"))
        (set "RelativeRotation" "(Pitch=0.000000,Yaw=-90.000000,Roll=0.000000)" (display "Relative Rotation")))))
  (graph "EventGraph"
    (node "K2Node_Event_0" "Event BeginPlay" (pos 0 0)
      (pin out "OutputDelegate" "Delegate")
      (pin out "then" "Exec"))
    (node "K2Node_Event_1" "Event ActorBeginOverlap" (pos 0 208)
      (pin out "OutputDelegate" "Delegate")
      (pin out "then" "Exec")
      (pin out "OtherActor" "Actor Object Reference"))
    (node "K2Node_Event_2" "Event Tick" (pos 0 416)
      (pin out "OutputDelegate" "Delegate")
      (pin out "then" "Exec")
      (pin out "DeltaSeconds" "Float (single-precision)" (default "0.0"))))
  (graph "UserConstructionScript"
    (node "K2Node_FunctionEntry_0" "Construction Script" (pos 0 0)
      (pin out "then" "Exec"))))
